{
  "name": "cypen-main-website",
  "services": [
    {
      "name": "web",
      "github": {
        "repo": "cypen-ai/cypen-main-website",
        "branch": "main"
      },
      "dockerfile_path": "Dockerfile",
      "instance_size_slug": "apps-s-1vcpu-0.5gb",
      "instance_count": 1,
      "http_port": 3000,
      "health_check": {
        "initial_delay_seconds": 15,
        "period_seconds": 10,
        "timeout_seconds": 5,
        "success_threshold": 1,
        "failure_threshold": 3,
        "http_path": "/healthz",
        "port": 3000
      },
      "alerts": [
        {
          "rule": "RESTART_COUNT",
          "operator": "GREATER_THAN",
          "value": 3,
          "window": "TEN_MINUTES"
        }
      ]
    }
  ],
  "domains": [
    {
      "domain": "cypen.ai",
      "type": "PRIMARY",
      "zone": "cypen.ai"
    },
    {
      "domain": "www.cypen.ai",
      "type": "ALIAS",
      "zone": "cypen.ai"
    },
    {
      "domain": "agenticsecurity.au",
      "type": "ALIAS",
      "wildcard": true
    },
    {
      "domain": "agenticsecurity.com.au",
      "type": "ALIAS",
      "wildcard": true
    }
  ],
  "region": "syd",
  "envs": [
    {
      "key": "HUBSPOT_PORTAL_ID",
      "value": "443548264",
      "scope": "RUN_TIME"
    },
