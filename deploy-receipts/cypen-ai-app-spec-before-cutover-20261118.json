      {
        "match": {
          "path": {
            "prefix": "/"
          },
          "authority": {
            "exact": "www.cypen.ai"
          }
        },
        "redirect": {
          "authority": "cypen.ai",
          "redirect_code": 301
        }
      },
      {
        "match": {
          "path": {
            "prefix": "/"
          }
        },
        "component": {
          "name": "web"
        }
      }
    ]
  },
  "features": [
    "buildpack-stack=ubuntu-22"
  ]
